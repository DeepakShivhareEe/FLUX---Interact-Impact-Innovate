# ──────────────────────────────────────────────────────────────
# Flux Backend Environment Configuration
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────────────────

# Port the Express server listens on (default: 4000)
PORT=4000

# MongoDB connection URI (required for database features)
# Example: mongodb+srv://user:pass@cluster.mongodb.net/flux?retryWrites=true&w=majority
MONGO_URI=

# Secret used to sign JWTs (required for auth features)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed CORS origins.
# If omitted, a sensible default set is used.
ALLOWED_ORIGINS=https://flux.org.in,https://www.flux.org.in

# Optional URL to ping every 10 minutes (Render free-tier keep-alive)
SELF_PING_URL=https://flux-backend-1hmq.onrender.com/ping

# ── Supabase (file uploads) ────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PPTS=ideathon_ppts
SUPABASE_BUCKET_PHOTOS=ideathon_photos

# ── Cloudinary (legacy, currently unused) ──────────────────────
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
CLOUD_PRESET=

# Admin token to access /api/admin/registrations and /api/admin/registrations.csv
ADMIN_TOKEN=flux-admin-secret-2026

# Optional allowed email domains comma-separated (empty = allow any domain)
ALLOWED_EMAIL_DOMAINS=

# ── SMTP Email Notifications (Nodemailer) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FLUX MMMUT <noreply@mmmut.ac.in>"

# ── HTTPS Email (Recommended for Render Free Tier to bypass SMTP port block) ──
RESEND_API_KEY=
RESEND_FROM="FLUX ByteBrawl <onboarding@resend.dev>"

# ── Brevo HTTPS API (Free 300 emails/day to ANY address, no domain setup needed) ──
BREVO_API_KEY=
BREVO_SENDER="fluxmmmut@gmail.com"

# --------------------------------------------------------------
# FLUX AI chatbot (backend /api/chat, Groq-powered)
# Get a free API key at https://console.groq.com/keys
# --------------------------------------------------------------
GROQ_API_KEY=

# Chat model id from your Groq account (https://console.groq.com/docs/models).
# Default if omitted: qwen/qwen3.8-27b  (fast free tier; auto-fallbacks to openai/gpt-oss-20b)
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: override the OpenAI-compatible API base URL
# GROQ_BASE_URL=https://api.groq.com/openai/v1
